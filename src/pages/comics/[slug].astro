---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const comics = await getCollection('comics');
  return comics.map((comic) => ({
    params: { slug: comic.id },
    props: { comic },
  }));
}

interface Props {
  comic: any;
}

const { comic } = Astro.props;
const { Content } = await render(comic);
---

<BaseLayout title={comic.data.title} description={comic.data.description}>
  <div class="container">
    <article class="comic-detail">
      <header class="comic-header">
        <a href="/comics/" class="back-link">← Back to Comics</a>
        
        <h1>{comic.data.title}</h1>
        
        <div class="comic-meta">
          <time dateTime={comic.data.pubDate.toISOString()}>
            {comic.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {comic.data.genre && (
            <span class="genre-badge">{comic.data.genre}</span>
          )}
        </div>

        <p class="comic-description">{comic.data.description}</p>
      </header>

      {comic.data.heroImage && (
        <div class="comic-hero">
          <img src={comic.data.heroImage} alt={comic.data.title} />
        </div>
      )}

      <div class="comic-content">
        <Content />
      </div>

      <footer class="comic-footer">
        <nav class="comic-nav">
          <a href="/comics/" class="button">← Back to Comics</a>
        </nav>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .comic-detail {
    max-width: 800px;
    margin: var(--spacing-4xl) auto;
  }

  .back-link {
    display: inline-block;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--spacing-lg);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  .comic-header {
    padding-bottom: var(--spacing-2xl);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-2xl);
  }

  h1 {
    margin: var(--spacing-lg) 0;
    line-height: 1.1;
  }

  .comic-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }

  time {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
  }

  .genre-badge {
    display: inline-block;
    background-color: var(--color-accent);
    color: var(--color-background);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: capitalize;
  }

  .comic-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .comic-hero {
    margin: var(--spacing-2xl) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .comic-hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  .comic-content {
    padding: var(--spacing-2xl) 0;
  }

  .comic-content :global(p) {
    line-height: 1.8;
    margin-bottom: var(--spacing-lg);
    color: var(--color-text-secondary);
  }

  .comic-content :global(h2) {
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-lg);
  }

  .comic-content :global(h3) {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .comic-content :global(ul),
  .comic-content :global(ol) {
    margin-left: var(--spacing-xl);
    margin-bottom: var(--spacing-lg);
  }

  .comic-content :global(li) {
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-secondary);
  }

  .comic-content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--spacing-lg);
    margin-left: 0;
    margin-bottom: var(--spacing-lg);
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .comic-footer {
    padding-top: var(--spacing-2xl);
    border-top: 1px solid var(--color-border);
    margin-top: var(--spacing-2xl);
  }

  .comic-nav {
    display: flex;
    gap: var(--spacing-lg);
  }

  .button {
    display: inline-block;
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 2px solid var(--color-text-primary);
    background-color: var(--color-text-primary);
    color: var(--color-background);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .button:hover {
    background-color: var(--color-background);
    color: var(--color-text-primary);
  }

  @media (max-width: 768px) {
    .comic-detail {
      margin: var(--spacing-2xl) auto;
    }

    h1 {
      font-size: var(--font-size-3xl);
    }

    .comic-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-sm);
    }
  }
</style>
