---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const comics = (await getCollection('comics')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Comics" description="Sequential stories and illustrated worlds.">
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">01 / Sequential art</p>
      <h1>Comics</h1>
      <p class="description">Little worlds in panels, collected one story at a time.</p>
    </header>

    {comics.length ? (
      <div class="comic-grid">
        {comics.map((comic) => (
          <a class="comic-card" href={`/comics/${comic.id}/`}>
            {comic.data.heroImage ? (
              <img src={comic.data.heroImage} alt="" loading="lazy" />
            ) : (
              <div class="comic-art" aria-hidden="true">{comic.data.title}</div>
            )}
            <div class="comic-card-copy">
              <div>
                <p class="eyebrow">{comic.data.genre ?? 'Sequential art'}</p>
                <h2>{comic.data.title}</h2>
                <p>{comic.data.description}</p>
              </div>
              <span aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state"><p>No comics published yet.</p><p class="hint">Add a comic entry under <code>src/content/comics/</code>.</p></div>
    )}
  </div>
</BaseLayout>

<style>
  .page-header { padding: 76px 0 40px; border-bottom: 1px solid var(--color-border); }
  .page-header h1 { margin: 0 0 18px; }
  .comic-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; padding: 42px 0 90px; }
  .comic-card { color: inherit; text-decoration: none; }
  .comic-card > img, .comic-art { display: grid; width: 100%; aspect-ratio: 1.45; place-items: center; object-fit: cover; background: var(--color-accent-yellow); }
  .comic-art { padding: 24px; font: 400 clamp(2rem, 5vw, 4rem)/1 var(--font-display); text-align: center; }
  .comic-card-copy { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; padding: 18px 2px; }
  .comic-card-copy .eyebrow { margin-bottom: 8px; }
  .comic-card-copy h2 { margin: 0 0 8px; font-size: 1.7rem; }
  .comic-card-copy p:last-child { margin: 0; color: var(--color-text-secondary); }
  .comic-card-copy > span { font-size: 1.4rem; }
  .comic-card:hover h2 { color: #c44b38; }
  @media (max-width: 650px) { .comic-grid { grid-template-columns: 1fr; } .page-header { padding-top: 54px; } }
</style>
