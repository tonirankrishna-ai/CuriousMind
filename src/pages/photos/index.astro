---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readdir } from 'node:fs/promises';
import { basename, extname, join, relative, sep } from 'node:path';
import { fileURLToPath } from 'node:url';

const photoDirectory = fileURLToPath(new URL('../../../public/images/photos/', import.meta.url));
const supportedExtensions = new Set(['.avif', '.gif', '.jpeg', '.jpg', '.png', '.webp']);
const supportedCategories = new Set(['street', 'nature', 'people', 'places']);

async function findPhotoFiles(directory: string): Promise<string[]> {
  let entries;

  try {
    entries = await readdir(directory, { withFileTypes: true });
  } catch {
    return [];
  }

  const nestedFiles = await Promise.all(entries.map(async (entry) => {
    const entryPath = join(directory, entry.name);

    if (entry.isDirectory()) return findPhotoFiles(entryPath);
    if (entry.isFile() && supportedExtensions.has(extname(entry.name).toLowerCase())) return [entryPath];
    return [];
  }));

  return nestedFiles.flat();
}

function makePhotoTitle(filename: string): string {
  const stem = basename(filename, extname(filename));
  const readable = stem.replace(/^\d+[-_.\s]*/, '').replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
  return (readable || stem).replace(/\b\w/g, (letter) => letter.toUpperCase());
}

const photoFiles = await findPhotoFiles(photoDirectory);
const sortedPhotos = photoFiles
  .map((filePath) => {
    const relativePath = relative(photoDirectory, filePath);
    const pathParts = relativePath.split(sep);
    const candidateCategory = pathParts.length > 1 ? pathParts[0].toLowerCase() : 'all';
    const category = supportedCategories.has(candidateCategory) ? candidateCategory : 'all';
    const imagePath = relativePath.split(sep).map(encodeURIComponent).join('/');

    return {
      title: makePhotoTitle(pathParts.at(-1) ?? relativePath),
      description: category === 'all' ? '' : `${category[0].toUpperCase()}${category.slice(1)} photography`,
      category,
      image: `/images/photos/${imagePath}`,
      sortKey: relativePath,
    };
  })
  .sort((first, second) => first.sortKey.localeCompare(second.sortKey, undefined, { numeric: true }));

const categories = ['all', 'street', 'nature', 'people', 'places'] as const;

---

<BaseLayout title="Photos" description="Visual moments captured">
  <div class="container">
    <section class="photos-header">
      <p class="label">Photography</p>
      <h1>Photos</h1>
      <p class="description">
        Moments I couldn't ignore. Shot on whatever I had with me.
      </p>
    </section>

    <section class="photos-gallery">
      <div class="category-filters">
        {categories.map((cat) => (
          <button class="filter-btn" data-category={cat} aria-pressed={cat === 'all' ? 'true' : 'false'} class:list={{ active: cat === 'all' }}>
            {cat.charAt(0).toUpperCase() + cat.slice(1)}
          </button>
        ))}
      </div>

      <div class="photos-grid" data-all="true">
        {sortedPhotos.map((photo) => (
          <div class="photo-card" data-category={photo.category}>
            <button class="photo-trigger" type="button" aria-haspopup="dialog" aria-label={`View ${photo.title}`}>
              <img src={photo.image} alt={photo.title} loading="lazy" />
              <span class="photo-overlay" aria-hidden="true">
                <span class="photo-title">{photo.title}</span>
                {photo.description && <span class="photo-description">{photo.description}</span>}
              </span>
            </button>
          </div>
        ))}
      </div>

      {sortedPhotos.length === 0 && (
        <div class="empty-state">
          <p>No photos yet. Check back soon!</p>
          <p class="hint">Upload image files to <code>public/images/photos/</code> in the GitHub repository.</p>
        </div>
      )}
    </section>

    <dialog class="photo-dialog" aria-label="Photo viewer">
      <div class="photo-dialog-frame">
        <button class="dialog-close" type="button" aria-label="Close photo viewer" title="Close">
          <span aria-hidden="true">×</span>
        </button>
        <button class="dialog-nav dialog-previous" type="button" aria-label="Previous photo" title="Previous photo">
          <span aria-hidden="true">‹</span>
        </button>
        <figure>
          <img class="dialog-image" alt="" />
          <figcaption>
            <strong class="dialog-title"></strong>
            <span class="dialog-description"></span>
          </figcaption>
        </figure>
        <button class="dialog-nav dialog-next" type="button" aria-label="Next photo" title="Next photo">
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </dialog>
  </div>
</BaseLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const photoCards = Array.from(document.querySelectorAll<HTMLElement>('.photo-card'));
  const photoDialog = document.querySelector<HTMLDialogElement>('.photo-dialog');
  const dialogImage = document.querySelector<HTMLImageElement>('.dialog-image');
  const dialogTitle = document.querySelector<HTMLElement>('.dialog-title');
  const dialogDescription = document.querySelector<HTMLElement>('.dialog-description');
  const closeButton = document.querySelector<HTMLButtonElement>('.dialog-close');
  const previousButton = document.querySelector<HTMLButtonElement>('.dialog-previous');
  const nextButton = document.querySelector<HTMLButtonElement>('.dialog-next');
  let visiblePhotos: HTMLElement[] = [];
  let activePhotoIndex = 0;

  function showPhoto(index: number) {
    if (!photoDialog || !dialogImage || !dialogTitle || !dialogDescription || visiblePhotos.length === 0) return;

    activePhotoIndex = (index + visiblePhotos.length) % visiblePhotos.length;
    if (previousButton) previousButton.hidden = visiblePhotos.length < 2;
    if (nextButton) nextButton.hidden = visiblePhotos.length < 2;
    const card = visiblePhotos[activePhotoIndex];
    const trigger = card.querySelector<HTMLButtonElement>('.photo-trigger');
    const image = trigger?.querySelector<HTMLImageElement>('img');

    if (!image) return;

    dialogImage.src = image.currentSrc || image.src;
    dialogImage.alt = image.alt;
    dialogTitle.textContent = trigger?.querySelector('.photo-title')?.textContent ?? image.alt;
    dialogDescription.textContent = trigger?.querySelector('.photo-description')?.textContent ?? '';
  }

  photoCards.forEach((card) => {
    card.querySelector<HTMLButtonElement>('.photo-trigger')?.addEventListener('click', () => {
      visiblePhotos = photoCards.filter((photo) => !photo.hidden);
      activePhotoIndex = visiblePhotos.indexOf(card);
      showPhoto(activePhotoIndex);
      photoDialog?.showModal();
    });
  });

  closeButton?.addEventListener('click', () => photoDialog?.close());
  previousButton?.addEventListener('click', () => showPhoto(activePhotoIndex - 1));
  nextButton?.addEventListener('click', () => showPhoto(activePhotoIndex + 1));

  photoDialog?.addEventListener('click', (event) => {
    if (event.target === photoDialog) photoDialog.close();
  });

  photoDialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') showPhoto(activePhotoIndex - 1);
    if (event.key === 'ArrowRight') showPhoto(activePhotoIndex + 1);
  });

  photoDialog?.addEventListener('close', () => {
    dialogImage?.removeAttribute('src');
  });

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.dataset.category ?? 'all';

      filterButtons.forEach((filterButton) => {
        const isActive = filterButton === button;
        filterButton.classList.toggle('active', isActive);
        filterButton.setAttribute('aria-pressed', String(isActive));
      });

      photoCards.forEach((card) => {
        card.hidden = category !== 'all' && card.dataset.category !== category;
      });
    });
  });
</script>

<style>
  .photos-header {
    padding: var(--spacing-4xl) 0 var(--spacing-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--spacing-lg);
  }

  h1 {
    margin-bottom: var(--spacing-lg);
    line-height: 1.1;
  }

  .description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  .photos-gallery {
    padding: var(--spacing-3xl) 0;
  }

  .category-filters {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-2xl);
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 2px solid var(--color-text-primary);
    background-color: transparent;
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .filter-btn:hover,
  .filter-btn.active {
    background-color: var(--color-text-primary);
    color: var(--color-background);
  }

  .photos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-3xl);
  }

  .photo-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 1;
    cursor: pointer;
  }

  .photo-trigger {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: zoom-in;
  }

  .photo-trigger:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
  }

  .photo-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .photo-trigger:hover img {
    transform: scale(1.05);
  }

  .photo-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.8) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--spacing-lg);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .photo-trigger:hover .photo-overlay,
  .photo-trigger:focus-visible .photo-overlay {
    opacity: 1;
  }

  .photo-title {
    display: block;
    color: var(--color-white);
    margin: 0 0 var(--spacing-sm);
    font-size: var(--font-size-lg);
  }

  .photo-description {
    display: block;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .photo-dialog {
    width: min(1100px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    color: var(--color-white);
  }

  .photo-dialog::backdrop {
    background: rgba(9, 12, 10, 0.92);
    backdrop-filter: blur(5px);
  }

  .photo-dialog-frame {
    position: relative;
    display: grid;
    min-height: 220px;
    grid-template-columns: 52px minmax(0, 1fr) 52px;
    align-items: center;
    gap: 12px;
  }

  .photo-dialog figure {
    display: grid;
    max-height: calc(100dvh - 48px);
    justify-items: center;
    gap: 12px;
    margin: 0;
  }

  .dialog-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 120px);
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .photo-dialog figcaption {
    display: grid;
    width: 100%;
    gap: 2px;
    color: var(--color-white);
    text-align: center;
  }

  .photo-dialog figcaption span {
    color: rgba(255, 255, 255, 0.76);
    font-size: var(--font-size-sm);
  }

  .dialog-close,
  .dialog-nav {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    background: rgba(24, 32, 27, 0.72);
    color: var(--color-white);
    cursor: pointer;
  }

  .dialog-close:hover,
  .dialog-nav:hover {
    background: var(--color-accent);
    color: var(--color-text-primary);
  }

  .dialog-close {
    position: absolute;
    z-index: 1;
    top: 12px;
    right: 64px;
    font-size: 1.8rem;
  }

  .dialog-nav {
    font-size: 2rem;
  }

  .empty-state {
    text-align: center;
    padding: var(--spacing-4xl) var(--spacing-2xl);
  }

  .empty-state p {
    margin: 0 0 var(--spacing-lg);
    font-size: var(--font-size-lg);
  }

  .hint {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
  }

  .hint a {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .photos-header {
      padding: var(--spacing-3xl) 0 var(--spacing-xl);
    }

    .photos-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: var(--spacing-md);
    }

    .category-filters {
      gap: var(--spacing-sm);
    }

    .filter-btn {
      padding: var(--spacing-xs) var(--spacing-md);
      font-size: var(--font-size-sm);
    }

    .photo-dialog {
      width: calc(100vw - 20px);
      max-height: calc(100dvh - 20px);
    }

    .photo-dialog-frame {
      grid-template-columns: 38px minmax(0, 1fr) 38px;
      gap: 4px;
    }

    .dialog-nav {
      width: 36px;
      height: 36px;
    }

    .dialog-close {
      top: -46px;
      right: 0;
    }

    .dialog-image {
      max-height: calc(100dvh - 130px);
    }
  }
</style>
