---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const comics = (await getCollection('comics')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const photos = (await getCollection('photos')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featuredComic = comics.find((entry) => entry.data.featured) ?? comics[0];
const featuredProject = projects.find((entry) => entry.data.featured) ?? projects[0];
const featuredPhoto = photos[0];
---

<BaseLayout description="A living archive of comics, photographs, experiments, and moving images.">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">An evolving creative archive · 2026</p>
      <h1>Small stories,<br /><em>big curiosity.</em></h1>
      <p class="hero-intro">A home for things I make, notice, and cannot stop thinking about. Come in, look around, stay curious.</p>
      <a class="button button-dark" href="/comics/">Explore the archive <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-art">
      <img
        src="/images/hero-art.png"
        alt="Illustration of a curious thinker and small companion exploring ideas"
        fetchpriority="high"
      />
      <span class="hero-note">notes from<br />the edge<br />of ordinary</span>
    </div>
  </section>

  <section class="archive-section" aria-labelledby="comics-heading">
    <div class="section-heading">
      <div><p class="eyebrow">01 / Sequential art</p><h2 id="comics-heading">Comics</h2></div>
      <a class="section-link" href="/comics/">All comics <span aria-hidden="true">↗</span></a>
    </div>
    {featuredComic ? (
      <a class="feature-card" href={`/comics/${featuredComic.id}/`}>
        {featuredComic.data.heroImage && <img src={featuredComic.data.heroImage} alt="" loading="lazy" />}
        <div class="feature-copy">
          <p class="tag">{featuredComic.data.genre ?? 'Sequential art'}</p>
          <h3>{featuredComic.data.title}</h3>
          <p>{featuredComic.data.description}</p>
        </div>
        <span class="feature-arrow" aria-hidden="true">↗</span>
      </a>
    ) : (
      <p class="section-note">Little worlds in panels. The first story is on its way.</p>
    )}
  </section>

  <section class="photo-band" aria-labelledby="photo-heading">
    <div class="photo-band-copy">
      <p class="eyebrow">02 / Observations</p>
      <h2 id="photo-heading">Photo diary</h2>
      <p>Light, texture, and the unexpected.</p>
      <a class="button button-light" href="/photos/">Browse photos <span aria-hidden="true">↗</span></a>
    </div>
    {featuredPhoto ? (
      <img src={featuredPhoto.data.image} alt={featuredPhoto.data.title} loading="lazy" />
    ) : (
      <img src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1200&q=85" alt="Sunlit mountain landscape" loading="lazy" />
    )}
  </section>

  <section class="archive-section project-section" aria-labelledby="project-heading">
    <div class="section-heading">
      <div><p class="eyebrow">03 / Experiments</p><h2 id="project-heading">Things in progress</h2></div>
      <a class="section-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a>
    </div>
    {featuredProject ? (
      <a class="project-feature" href="/projects/">
        <span class="project-number">01</span>
        <span class="project-feature-copy"><strong>{featuredProject.data.title}</strong><span>{featuredProject.data.description}</span></span>
        <span class="project-status">{featuredProject.data.status}</span>
        <span class="feature-arrow" aria-hidden="true">↗</span>
      </a>
    ) : (
      <p class="section-note">Small experiments and side quests are coming soon.</p>
    )}
  </section>

  <section class="video-band">
    <div><p class="eyebrow">04 / Moving image</p><h2>Watch this space.</h2><p>Process notes, short films, and things that move.</p></div>
    <a class="video-mark" href="/videos/" aria-label="Visit videos"><span aria-hidden="true">▶</span></a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: 620px;
    grid-template-columns: 1fr 0.9fr;
    align-items: center;
    gap: 4vw;
    overflow: hidden;
    padding: 72px 10vw 90px;
  }

  .hero-copy { position: relative; z-index: 1; max-width: 620px; }
  .hero h1 { margin: 0 0 30px; font-size: 6.2rem; }
  .hero h1 em { color: var(--color-accent); font-style: italic; }
  .hero-intro { max-width: 360px; font-size: 1.05rem; }
  .button { display: inline-flex; min-height: 48px; align-items: center; justify-content: space-between; gap: 26px; margin-top: 18px; padding: 13px 18px; font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); text-decoration: none; text-transform: uppercase; }
  .button-dark { background: var(--color-text-primary); color: var(--color-background); }
  .button-light { border: 1px solid rgba(255, 255, 255, 0.65); color: #fffdf8; }
  .button:hover { background: var(--color-accent); color: var(--color-text-primary); }
  .hero-art {
    position: relative;
    width: min(44vw, 540px);
    aspect-ratio: 1.15;
    justify-self: end;
    transform: rotate(2.5deg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 10px;
    transition: transform var(--transition-base);
  }
  .hero-art:hover {
    transform: rotate(0deg) scale(1.01);
  }
  .hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .hero-note {
    position: absolute;
    right: -12px;
    bottom: -14px;
    padding: 12px 16px;
    background: var(--color-accent-yellow);
    border: 1px solid var(--color-text-primary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 var(--color-text-primary);
    z-index: 2;
  }
  .archive-section { padding: 90px 10vw; border-top: 1px solid var(--color-border); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 36px; }
  .section-heading .eyebrow { margin-bottom: 14px; }
  .section-heading h2, .photo-band h2, .video-band h2 { margin: 0; }
  .section-link { flex: 0 0 auto; font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); text-decoration: none; text-transform: uppercase; }
  .section-link:hover { color: #c44b38; }
  .feature-card { position: relative; display: grid; min-height: 280px; grid-template-columns: 1.1fr 0.9fr; align-items: stretch; background: #e9e3d7; text-decoration: none; }
  .feature-card > img { width: 100%; height: 100%; min-height: 280px; object-fit: cover; }
  .feature-copy { align-self: center; padding: 32px; }
  .feature-copy h3 { margin: 0 0 12px; font-size: 2rem; }
  .feature-copy p:last-child { max-width: 420px; margin: 0; color: var(--color-text-secondary); }
  .tag { color: var(--color-text-secondary); font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); text-transform: uppercase; }
  .feature-arrow { position: absolute; top: 22px; right: 22px; font-size: 1.5rem; }
  .section-note { margin: 0; color: var(--color-text-secondary); }
  .photo-band { display: grid; min-height: 420px; grid-template-columns: 0.8fr 1.2fr; background: var(--color-text-primary); color: var(--color-background); }
  .photo-band-copy { align-self: center; padding: 56px 10vw; }
  .photo-band .eyebrow { color: #c4ccba; }
  .photo-band h2 { max-width: 400px; margin-bottom: 20px; }
  .photo-band-copy > p:not(.eyebrow) { max-width: 300px; color: #c4ccba; }
  .photo-band > img { width: 100%; height: 100%; min-height: 420px; object-fit: cover; }
  .project-feature { display: grid; grid-template-columns: 50px 1fr 120px 24px; align-items: center; gap: 20px; padding: 24px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); text-decoration: none; }
  .project-number, .project-status { color: var(--color-text-secondary); font-size: var(--font-size-xs); text-transform: uppercase; }
  .project-feature-copy { display: grid; gap: 6px; }
  .project-feature-copy strong { font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; }
  .project-feature-copy span { color: var(--color-text-secondary); }
  .feature-arrow { font-size: 1.4rem; }
  .project-feature:hover { color: #c44b38; }
  .video-band { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding: 80px 10vw; background: var(--color-accent); }
  .video-band h2 { max-width: 460px; margin-bottom: 14px; }
  .video-band p:last-child { max-width: 320px; margin: 0; }
  .video-mark { display: grid; width: 150px; aspect-ratio: 1; flex: 0 0 auto; place-items: center; border: 1px solid var(--color-text-primary); border-radius: 50%; text-decoration: none; transition: transform var(--transition-base), background var(--transition-base); }
  .video-mark span { margin-left: 5px; font-size: 1.5rem; }
  .video-mark:hover { transform: rotate(10deg); background: var(--color-accent-yellow); }

  @media (max-width: 1000px) {
    .hero h1 { font-size: 4.2rem; }
  }

  @media (max-width: 760px) {
    .hero { display: block; min-height: 0; padding: 64px 8vw 26px; }
    .hero h1 { font-size: 2.7rem; }
    .hero-art { width: min(85vw, 360px); margin: 36px auto 0; }
    .hero-note { right: 8px; bottom: -10px; padding: 8px 12px; }
    .archive-section { padding: 68px 8vw; }
    .section-heading { align-items: flex-start; flex-direction: column; }
    .feature-card { grid-template-columns: 1fr; }
    .feature-card > img { min-height: 200px; max-height: 300px; }
    .photo-band { grid-template-columns: 1fr; }
    .photo-band-copy { padding: 64px 8vw 32px; }
    .photo-band > img { min-height: 260px; max-height: 380px; }
    .project-feature { grid-template-columns: 28px 1fr 22px; gap: 12px; }
    .project-status { display: none; }
    .project-feature-copy strong { font-size: 1.25rem; }
    .video-band { align-items: flex-start; flex-direction: column; padding: 68px 8vw; }
    .video-mark { width: 110px; }
  }
</style>
