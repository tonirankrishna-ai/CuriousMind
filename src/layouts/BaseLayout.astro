---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/variables.css';
import '../styles/globals.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = 'Curious Mind | Creative Archive',
  description = 'A living archive of comics, photographs, experiments, and moving images.',
} = Astro.props;
const pageTitle = title.includes('Curious Mind') ? title : `${title} | Curious Mind`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e8" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
